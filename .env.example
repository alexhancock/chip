# chip configuration — copy to .env and fill in what you need.
#   cp .env.example .env
# Everything here is optional except an Anthropic credential: chip needs Claude
# to fill in tool arguments. Without TYPESAFE_API_KEY, Claude also stands in for
# the decision model.

# --- Anthropic (required: key here, exported in your shell, or `ant auth login`) ---
ANTHROPIC_API_KEY=

# --- Jev / TypeSafe (optional: set this to decide with Jev instead of Claude) ---
TYPESAFE_API_KEY=

# --- Settings (all optional, defaults shown) ---
# Claude model used to fill in tool arguments
CHIP_CLAUDE_MODEL=claude-sonnet-5-5
# low | medium | high
CHIP_EFFORT=low
# max output tokens when filling in arguments
CHIP_MAX_TOKENS=16000
# give up after this many steps
CHIP_MAX_STEPS=12
# stop if no tool beats this confidence
CHIP_MIN_CONFIDENCE=0.25
# decision model used when TYPESAFE_API_KEY is set
TYPESAFE_DEFAULT_MODEL=jev-latest
